TINYFISH_API_KEY=
OPENAI_API_KEY=
SUBSTACK_API_KEY=
SUBSTACK_PUBLICATION_ID=
DATABASE_URL=postgresql://mse:mse@localhost:5432/mse
SLACK_WEBHOOK_URL=
NODE_ENV=development
PUBLISH_TIME_IST=08:00
VITE_APP_URL=http://localhost:3000

# TinyFish tuning. FREE TIER: keep these defaults — only "lite"/false/2 are valid
# (other values return HTTP 400). Raise concurrency / change profile only on a paid
# plan. Exchange sites (NSE/BSE/SEBI) may still time out intermittently on free tier.
TINYFISH_CONCURRENCY=2
TINYFISH_BROWSER_PROFILE=lite
TINYFISH_PROXY=false

# Dashboard: when true, show sample/demo data if the DB has no scores yet.
# Leave false in production so an empty pipeline shows an honest "no data" state.
USE_MOCK_DATA=false
