{
  "name": "market-story-engine",
  "private": true,
  "workspaces": [
    "ingestion",
    "synthesis",
    "publisher",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=ingestion\" \"npm run dev --workspace=synthesis\" \"npm run dev --workspace=publisher\"",
    "build": "npm run build --workspaces",
    "poc:nse": "tsx scripts/poc-nse-fii.ts",
    "poc:synthesis": "tsx scripts/poc-synthesis.ts",
    "test:runner": "tsx scripts/test-runner.ts",
    "backfill": "tsx scripts/backfill-briefs.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "setup:deployment": "bash scripts/setup-deployment.sh",
    "cron": "tsx scripts/cron-runner.ts",
    "cron:daily": "tsx scripts/cron-runner.ts daily",
    "cron:sector:morning": "tsx scripts/cron-runner.ts sector:morning",
    "cron:sector:midsession": "tsx scripts/cron-runner.ts sector:midsession",
    "cron:sector:closing": "tsx scripts/cron-runner.ts sector:closing"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0"
  }
}
