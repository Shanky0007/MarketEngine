{
  "name": "market-story-engine",
  "private": true,
  "workspaces": [
    "ingestion",
    "synthesis",
    "publisher",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=ingestion\" \"npm run dev --workspace=synthesis\" \"npm run dev --workspace=publisher\"",
    "build": "npm run build --workspaces",
    "poc:nse": "tsx scripts/poc-nse-fii.ts",
    "poc:synthesis": "tsx scripts/poc-synthesis.ts",
    "test:runner": "tsx scripts/test-runner.ts"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "openai": "^6.32.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0"
  }
}
